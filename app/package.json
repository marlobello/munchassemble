{
  "name": "munchassemble-bot",
  "version": "1.0.0",
  "description": "Discord bot for coordinating lunch outings — Munch Assemble",
  "main": "dist/index.js",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "start": "node dist/index.js",
    "start:web": "node dist/web/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:web": "tsx watch src/web/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src tests --ext .ts",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@azure/cosmos": "^4.10.1",
    "@azure/identity": "^4.14.1",
    "@azure/keyvault-secrets": "^4.12.0",
    "discord.js": "^14.28.0",
    "node-cron": "^4.6.0"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  }
}
